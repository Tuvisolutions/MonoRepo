# Google AI Studio / Gemini API key (never commit the real key)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional override — default works well for vision OCR
GEMINI_MODEL=gemini-3.1-flash-lite

# Server
HOST=0.0.0.0
PORT=8090

# --- Sustainability Wise prod training fetch (optional) ---
# Prefer: python scripts/fetch_sw_electrical_photos.py --ssh-prod
# Or copy vars from /opt/sw-api/.env:
# DATABASE_URL=postgres://...
# SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
# SPACES_REGION=syd1
# SPACES_BUCKET=sw-prod-files-syd1
# SPACES_ACCESS_KEY_ID=
# SPACES_SECRET_ACCESS_KEY=
